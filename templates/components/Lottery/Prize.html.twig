{% trans_default_domain 'crowdfunding' %}

{# "ticketClass" and not "class": Card declares a "class" prop, and a component's slot is rendered in the component's own context - a "class" set here is shadowed by the card's empty one, which is what left the drawn ticket without its gold #}
{% set ticketClass = "not-drawn" %}
{% set number = "XX-0000-YYY" %}
{% set name = 'label.not_yet_drawn'|trans %}
{% if true == winner %}
    {% set ticketClass = "winner" %}
    {% set number = prize.winningTicket.number %}
    {% set contributorName = null != prize.winningTicket.contributor.name ? prize.winningTicket.contributor.name : 'label.anonymous'|trans %}
    {% set name = 'label.name'|trans ~ ": <strong>" ~ contributorName ~ "</strong>" %}
    {% set disabled = "disabled" %}
{% endif %}
<twig:c975LUi:Card:Card tag="article" id="prize-{{ prize.id }}" class="crowdfunding-prize" title="#{{ prize.rank }} - {{ prize.title }}">
    {# No ".card-data": UiBundle pins a whole tail to the bottom of the body (sass/_cards.scss), where only the draw belongs there and the description has to keep reading from the top. This bundle does that pinning itself, on the block below #}
    <div class="text-center" data-prize-rank="{{ prize.rank }}">
        <p class="text-left">{{ prize.description|raw|nl2br }}</p>
        {# The draw itself, in a block of its own: it is pinned to the bottom of the card (see sass/_lottery.scss), so the winning tickets of prizes described in three lines and in six read on one line #}
        <div class="crowdfunding-prize__draw">
            <h3>{{ 'label.winner_ticket'|trans({}, 'crowdfunding') }}</h3>
            <p class="ticket-number {{ ticketClass }}" data-lottery-target="winnerNumber">{{ number }}</p>
            <p data-lottery-target="winnerName">{{ name|raw }}</p>
            {# Draw #}
            {% if prize.lottery.tickets is not empty and false == winner and is_granted(config('site-role-admin')) %}
                {% set disabled = "" %}
                {% if date() < prize.lottery.drawDate %}
                    {% set disabled = "disabled" %}
                {% endif %}
                <twig:c975LCrowdfunding:Lottery:DrawButton rank="{{ prize.rank }}" disabled="{{ disabled }}"/>
            {% elseif true == winner %}
                <p class="text text-center">{{ 'label.draw_date'|trans({}, 'crowdfunding') }} : <strong>{{ prize.drawDate|date('d/m/Y - H:i', app.session.get('user_timezone', 'Europe/Paris')) }}</strong></p>
            {% endif %}
        </div>
    </div>
</twig:c975LUi:Card:Card>
