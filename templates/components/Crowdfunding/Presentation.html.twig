{# The use of the funds is optional here: the campaign page moved it onto the band it shares with the author, and passes showUse="false" so it is not said twice. "??" not "default", which also substitutes on an explicit false #}
{% set showUse = showUse ?? true %}
{# The pencil UiBundle's overlay draws on any [data-block-edit-url] (see block-edit-overlay.js): a composed block gets one through CrowdfundingBlockEditUrlProvider, a section the page hardcodes gets it here, pointing at the very field the section is written in. Answers null to anyone but an editor #}
{% set editUrl = crowdfunding_edit_url(crowdfunding, 'description') %}
<section id="presentation"{% if editUrl %} data-block-edit-url="{{ editUrl }}"{% endif %}>
    <h2>{{ 'label.presentation'|trans({}, 'crowdfunding') }}</h2>
    <twig:c975LCrowdfunding:Crowdfunding:Videos videos="{{ crowdfunding.videos }}" editUrl="{{ crowdfunding_edit_url(crowdfunding, 'videos') }}"/>
    <h3>{{ 'label.project'|trans({}, 'crowdfunding') }}</h3>
    {{ crowdfunding.description|raw }}
    {% if showUse %}
        <h3>{{ 'label.use'|trans({}, 'crowdfunding') }}</h3>
        {{ crowdfunding.useFor|raw }}
    {% endif %}
</section>
