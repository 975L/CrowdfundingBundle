{# <twig:c975LCrowdfunding:Crowdfunding:Hero crowdfunding="{{ crowdfunding }}"/> #}
{# The campaign's opening image with its title over it. Rendered by the page only when no "banner_title" block was composed: an editor who placed one has said where the opening goes, and this would print a second one above it #}
{% trans_default_domain 'crowdfunding' %}
{% props crowdfunding %}

{# The pencil UiBundle's overlay draws on any [data-block-edit-url] (see block-edit-overlay.js): a composed block gets one through CrowdfundingBlockEditUrlProvider, a section the page hardcodes gets it here, pointing at the very field the section is written in. Answers null to anyone but an editor #}
{% set editUrl = crowdfunding_edit_url(crowdfunding, 'heroes') %}
<section class="crowdfunding-hero"{% if editUrl %} data-block-edit-url="{{ editUrl }}"{% endif %}>
    {# The campaign's own opening image, uploaded on its own field: no fallback on the slider's first plate, which would open the page on whatever an editor happened to sort first #}
    {% set opening = crowdfunding.heroes|first %}
    {% if opening %}
        {# Decorative: the title beside it already names the campaign #}
        <img class="crowdfunding-hero__image" src="{{ asset(opening.name) }}" alt="" aria-hidden="true" loading="eager" fetchpriority="high">
    {% endif %}
    <div class="crowdfunding-hero__caption">
        <p class="crowdfunding-hero__meta">
            {{ 'label.crowdfunding'|trans }}
            {% if crowdfunding.beginDate and crowdfunding.endDate %}
                &middot; {{ crowdfunding.beginDate|date('d/m/Y') }} - {{ crowdfunding.endDate|date('d/m/Y') }}
            {% endif %}
        </p>
        <h1 class="crowdfunding-hero__title">{{ crowdfunding.title }}</h1>
    </div>
</section>
