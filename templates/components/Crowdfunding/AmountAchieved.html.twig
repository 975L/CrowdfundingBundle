{% set type = type | default('primary') %}
{% set label = 'label.next_smiley'|trans({}, 'crowdfunding') %}

{% set isStarted = date()|date("Y-m-d H:i:s") > crowdfunding.beginDate|date("Y-m-d 00:00:00") %}
{% set endOfDay = date(crowdfunding.endDate|date("Y-m-d 23:59:59")) %}
{% set isEnded = date() > endOfDay %}
{% set progressPercent = (crowdfunding.amountAchieved / crowdfunding.amountGoal * 100)|round %}
<section id="funding">
    <h2>{{ 'label.funding'|trans({}, 'crowdfunding') }}</h2>
    <p><strong>{{ (crowdfunding.amountAchieved / 100)|format_currency(crowdfunding.currency, {fraction_digit: 0}) }}</strong> {{ 'label.outof'|trans({}, 'crowdfunding') }} <strong>{{ (crowdfunding.amountGoal / 100)|format_currency(crowdfunding.currency, {fraction_digit: 0}) }}</strong></p>
    <twig:c975LUi:Progress:Bar progressPercent="{{ progressPercent }}" text="true"/>
    <twig:c975LCrowdfunding:Crowdfunding:ContributorsNumber contributorsLength="{{ crowdfunding.contributors|length }}"/>
    <twig:c975LCrowdfunding:Crowdfunding:Smileys progressPercent="{{ progressPercent }}"/>
    {% if false == isStarted %}
        <twig:c975LCrowdfunding:CrowdfundingCounterpart:AddButtonNotStarted type="{{ type }}" beginDate="{{ crowdfunding.beginDate }}"/>
    {% elseif isEnded %}
        <twig:c975LCrowdfunding:CrowdfundingCounterpart:AddButtonIsEnded type="{{ type }}"/>
    {% else %}
        <twig:c975LUi:Button:Button label="{{ 'label.next_smiley'|trans({}, 'crowdfunding') }}" url="#counterparts"/>
    {% endif %}
</section>