{# <twig:c975LCrowdfunding:Crowdfunding:FundingTopBar crowdfunding="{{ crowdfunding }}"/> #}
{# The campaign's funding kept in sight the whole way down the page, compact: the rail below only stands beside the story and ends with it, so past the counterparts this strip is what still says where the campaign stands and how to join it #}
{% trans_default_domain 'crowdfunding' %}
{% props crowdfunding %}

{% set state = crowdfunding_funding_state(crowdfunding) %}

<div class="crowdfunding-topbar">
    <p class="crowdfunding-topbar__title">{{ crowdfunding.title }}</p>

    <div class="crowdfunding-topbar__gauge">
        <p class="crowdfunding-topbar__figures">
            <strong>{{ (crowdfunding.amountAchieved / 100)|format_currency(crowdfunding.currency, {fraction_digit: 0}) }}</strong>
            {{ 'label.outof'|trans }}
            <strong>{{ (crowdfunding.amountGoal / 100)|format_currency(crowdfunding.currency, {fraction_digit: 0}) }}</strong>
            <span class="crowdfunding-topbar__percent">{{ state.progressPercent }}&nbsp;%</span>
            {% if state.isStarted and false == state.isEnded %}
                <span class="crowdfunding-topbar__days">
                    {%- if state.isLastDay %}{{ 'label.last_day'|trans }}{% else %}{{ state.daysLeft }} {{ 'label.days_left'|trans }}{% endif -%}
                </span>
            {% endif %}
        </p>
        <twig:c975LUi:Progress:Bar progressPercent="{{ state.progressPercent }}"/>
    </div>

    {# Only a campaign one can actually join carries the button: the two closed states are said in full by the rail, and repeating them here would only take the strip's width from the figures #}
    {% if state.isStarted and false == state.isEnded %}
        <twig:c975LUi:Button:Button label="{{ 'label.contribute'|trans }}" url="#counterparts" inline="true"/>
    {% endif %}
</div>
