{# No heading of its own, the page this listing is the whole content of being already titled by the layout (see crowdfunding/index.html.twig), and the editor's floating pencil is mounted here rather than by UiBundle's Blocks wrapper, which a listing composed of no block never draws #}
{% set canEdit = is_granted(config('site-role-editor')) %}
<section id="crowdfundings">
    {% if crowdfundings is not empty %}
        {# The ecosystem's own row of cards (UiBundle sass/_cards.scss): it already stretches the cards to a common height and spaces them by the site's --cards-gap, which the listing used to restate for itself #}
        <div class="cards crowdfundings"{% if canEdit %} data-controller="blockEditOverlay" data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
            {% for crowdfunding in crowdfundings %}
                <twig:c975LCrowdfunding:Crowdfunding:Crowdfunding crowdfunding="{{ crowdfunding }}"/>
            {% endfor %}
        </div>
    {% else %}
        <p class="text text-center lead">{{ 'label.no_crowdfunding'|trans({}, 'crowdfunding') }}</p>
    {% endif %}
</section>