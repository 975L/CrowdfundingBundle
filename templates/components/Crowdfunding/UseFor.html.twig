{# <twig:c975LCrowdfunding:Crowdfunding:UseFor crowdfunding="{{ crowdfunding }}"/> #}
{# What the money raised pays for, said on its own rather than as a subhead of the presentation: it is the answer a visitor weighs the tiers against, so it stands beside the author on the band between the story and the counterparts #}
{% trans_default_domain 'crowdfunding' %}
{% props crowdfunding %}

{# The pencil UiBundle's overlay draws on any [data-block-edit-url] (see block-edit-overlay.js): a composed block gets one through CrowdfundingBlockEditUrlProvider, a section the page hardcodes gets it here, pointing at the very field the section is written in. Answers null to anyone but an editor #}
{% set editUrl = crowdfunding_edit_url(crowdfunding, 'useFor') %}
<section id="use-for"{% if editUrl %} data-block-edit-url="{{ editUrl }}"{% endif %}>
    <h2>{{ 'label.use'|trans }}</h2>
    {{ crowdfunding.useFor|raw }}
</section>
