<section id="contributors">
    <h2>{{ 'label.contributors'|trans({}, 'crowdfunding') }}</h2>
    {% if contributors is not empty %}
        <p class="text text-center italic">{{ 'label.only_those_left_message'|trans({}, 'crowdfunding') }}</p>
        <div class="cards">
            {% for contributor in contributors %}
                <twig:c975LCrowdfunding:Crowdfunding:Contributor contributor="{{ contributor }}"/>
            {% endfor %}
        </div>
    {% else %}
        <p class="text text-center">{{ 'label.no_contributor'|trans({}, 'crowdfunding') }}</p>
    {% endif %}
</section>