{# <twig:c975LCrowdfunding:CrowdfundingCounterpart:AddButton crowdfundingCounterpart="{{ counterpart }}" [type="primary"] [quantity="1"]/> #}
{# Rendered on an open campaign and on no other (see components/Crowdfunding/Counterpart.html.twig): what a closed or unopened campaign says is said once above the run of tiers, and not as a dead button on every row #}
{% set type = type | default('primary') %}
{% set quantity = quantity | default(1) %}
{% set label = 'label.i_contribute'|trans({}, 'crowdfunding') %}

{# The two cases a tier itself refuses: none was ever offered, or every one of them is taken #}
{% set disabled = "" %}
{% if crowdfundingCounterpart.limitedQuantity is same as 0 %}
    {% set disabled = "disabled" %}
    {% set label = 'label.unavailable'|trans({}, 'crowdfunding') %}
{% elseif crowdfundingCounterpart.limitedQuantity > 0 and crowdfundingCounterpart.orderedQuantity >= crowdfundingCounterpart.limitedQuantity %}
    {% set disabled = "disabled" %}
    {% set label = 'label.limited_quantity_reached'|trans({}, 'crowdfunding') %}
{% endif %}

<button
    {{ disabled }}
    data-action="click->basket#addItem"
    data-type="crowdfunding"
    data-quantity="{{ quantity }}"
    data-limited="{{ crowdfundingCounterpart.limitedQuantity|default(0) }}"
    data-ordered="{{ crowdfundingCounterpart.orderedQuantity|default(0) }}"
    data-item-id="{{ crowdfundingCounterpart.id }}"
    data-title="{{ crowdfundingCounterpart.title }}"
    data-alert="success"
    data-text="{{ 'label.added'|trans({}, 'crowdfunding') }}"
    class="btn btn-large btn-{{ type }}">
    <twig:c975LUi:Image:Icon src="bundles/c975lcrowdfunding/icons/face-grin.svg" width="24" height="24" class="white"/> {{ label }}
</button>
