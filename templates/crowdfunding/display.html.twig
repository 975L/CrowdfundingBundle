{% extends 'layout.html.twig' %}
{% trans_default_domain 'crowdfunding' %}

{# Defines specific variables #}
{% set title = 'label.crowdfunding'|trans ~ ' : "' ~ crowdfunding.title ~ '"' %}
{% if crowdfunding.medias is not empty %}
    {% set ogImage = absolute_url(asset(crowdfunding.medias[0].name)) %}
{% endif %}

{% set summarySocialNetwork = crowdfunding.description %}

{% block content %}
    <twig:c975LPayment:Basket:TestMode/>
    <div class="crowdfunding">
        <twig:c975LCrowdfunding:Crowdfunding:AmountGoal amount="{{ crowdfunding.amountGoal }}" currency="{{ crowdfunding.currency }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:AmountAchieved crowdfunding="{{ crowdfunding }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:Author name="{{ crowdfunding.authorName }}" presentation="{{ crowdfunding.authorPresentation }}" website="{{ crowdfunding.authorWebsite }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:Dates beginDate="{{ crowdfunding.beginDate }}" endDate="{{ crowdfunding.endDate }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:Presentation crowdfunding="{{ crowdfunding }}"/>
        <twig:c975LUi:Slider:Slider media="{{ crowdfunding.medias }}" id="slider" class="img-500" duration="3500" fallbackAlt="{{ crowdfunding.title }}"/>
        <twig:c975LCrowdfunding:Lottery:Lotteries lotteries="{{ crowdfunding.lotteries }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:CounterParts counterparts="{{ crowdfunding.counterparts }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:NewsCollection newsCollection="{{ crowdfunding.news }}" form="{{ form }}"/>
        <twig:c975LCrowdfunding:Crowdfunding:Contributors contributors="{{ crowdfunding.contributors }}"/>

        {# Composed in the back office with UiBundle's own kinds - a banner, the arguments, a gallery, a FAQ - so a campaign says what it needs without a template written for it #}
        <twig:c975LUi:Blocks:Blocks blocks="{{ crowdfunding.blocks }}"/>
    </div>
{% endblock %}
