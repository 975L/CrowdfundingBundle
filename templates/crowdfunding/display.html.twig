{% extends 'layout.html.twig' %}
{% trans_default_domain 'crowdfunding' %}

{# Defines specific variables #}
{% set title = 'label.crowdfunding'|trans ~ ' : "' ~ crowdfunding.title ~ '"' %}
{# What a shared link is drawn with: the campaign's cover, the opening image for one written before the two were told apart, and nothing for a campaign holding neither #}
{% set ogMedia = crowdfunding.covers|first ?: crowdfunding.heroes|first %}
{% if ogMedia %}
    {% set ogImage = absolute_url(asset(ogMedia.name)) %}
{% endif %}

{% set summarySocialNetwork = crowdfunding.description %}

{# The sections a block of this bundle can take over: placed on the campaign, the block is where the editor put it, and the hardcoded section below steps aside rather than showing it twice #}
{% set sheetKinds = crowdfunding_block_sheet_kinds(crowdfunding.blocks) %}

{# The campaign's name is printed over its opening image, so the layout's plain heading would say it a second time - unless an editor composed a banner of their own, which carries whatever level they set and leaves the page without a title of its own #}
{% set headingDisplayed = 'banner_title' in sheetKinds %}

{% block content %}
    <twig:c975LPayment:Basket:TestMode/>
    {# An editor reading a campaign before it is opened (see CrowdfundingController::preview()) - the page is otherwise the public one, so it says which of the two this is #}
    {% if isPreview|default(false) and crowdfunding.hidden %}
        <twig:c975LUi:Alert:Alert type="warning" message="{{ 'label.preview_mode'|trans }}"/>
    {% endif %}
    <div class="crowdfunding crowdfunding--page">
        {% if 'banner_title' not in sheetKinds %}
            <twig:c975LCrowdfunding:Crowdfunding:Hero crowdfunding="{{ crowdfunding }}"/>
        {% endif %}

        {# The whole campaign, in two columns from 1024px up: everything that is read on the left - the story, what the money pays for, the chronicle - and only what a contribution is decided on beside it, the funding and the tiers. The same split the crowdfunding platforms use, and what keeps the left column from ending under the slider with the rail still running #}
        <div class="crowdfunding-layout">
            {# The rail: the funding, the tiers it is reached through, then the draw a contribution also enters - all three are what a visitor weighs a contribution against, so all three stay in sight while the story is read. Same place the shop puts a product's own buying column (see ShopBundle templates/product/display.html.twig) #}
            <div class="crowdfunding-rail">
                <twig:c975LCrowdfunding:Crowdfunding:FundingBar crowdfunding="{{ crowdfunding }}"/>
                {% if 'crowdfunding_lottery' not in sheetKinds %}
                    <twig:c975LCrowdfunding:Lottery:Lotteries lotteries="{{ crowdfunding.lotteries }}"/>
                {% endif %}
                {% if 'crowdfunding_counterparts' not in sheetKinds %}
                    <twig:c975LCrowdfunding:Crowdfunding:CounterParts counterparts="{{ crowdfunding.counterparts }}"/>
                {% endif %}
            </div>

            <div class="crowdfunding-main">
                {# ":showUse", not "showUse": the plain attribute passes the string "false", which Twig reads as true, and the use of the funds was printed both here and on the band below #}
                <twig:c975LCrowdfunding:Crowdfunding:Presentation crowdfunding="{{ crowdfunding }}" :showUse="false"/>

                {# What the campaign says around its counterparts - composed in the back office, nothing to add here when it has no block #}
                <twig:c975LUi:Blocks:Blocks blocks="{{ crowdfunding.blocks }}"/>

                {% if 'crowdfunding_slider' not in sheetKinds %}
                    <twig:c975LUi:Slider:Slider media="{{ crowdfunding.slides }}" id="slider" class="img-500" duration="3500" fallbackAlt="{{ crowdfunding.title }}"/>
                {% endif %}
            </div>

            {# What the money pays for and who is asking for it, on one band under the story: the two answers a visitor weighs a tier against, read together rather than one at each end of the page. Inside the layout and not after it, so that on a phone it can be ordered between the story and the tiers - only siblings order against each other (see sass/_crowdfunding-blocks.scss) #}
            <div class="crowdfunding-support section--bg-muted">
                <twig:c975LCrowdfunding:Crowdfunding:UseFor crowdfunding="{{ crowdfunding }}"/>
                <twig:c975LCrowdfunding:Crowdfunding:Author name="{{ crowdfunding.authorName }}" presentation="{{ crowdfunding.authorPresentation }}" website="{{ crowdfunding.authorWebsite }}" editUrl="{{ crowdfunding_edit_url(crowdfunding, 'authorName') }}"/>
            </div>

            {# The campaign's chronicle, after everything it is composed of: the news carry a form only a signed-in visitor sees, which no block can hold. In the story's column like everything else that is read rather than acted on - the rail beside it holds the funding and the tiers, and nothing else #}
            <div class="crowdfunding-chronicle">
                <twig:c975LCrowdfunding:Crowdfunding:NewsCollection crowdfunding="{{ crowdfunding }}" newsCollection="{{ crowdfunding.news }}" form="{{ form }}"/>
                <twig:c975LCrowdfunding:Crowdfunding:Contributors contributors="{{ crowdfunding.contributors }}"/>
            </div>
        </div>
    </div>
{% endblock %}
