{% extends '@c975LCrowdfunding/emails/layout.html.twig' %}
{% trans_default_domain 'shop' %}

{% block email_content %}
    <twig:c975LPayment:Basket:Thanks/>
    <twig:c975LPayment:Basket:Number number="{{ basket.number }}" securityToken="{{ basket.securityToken }}"/>
    <twig:c975LPayment:Basket:CounterpartsReminder/>
    <twig:c975LPayment:Basket:Counterparts counterparts="{{ counterparts }}"/>
    <twig:c975LPayment:Basket:Delivery basket="{{ basket }}"/>
{% endblock %}